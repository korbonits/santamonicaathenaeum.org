---
import Base from "../layouts/Base.astro";
import { ACQUISITIONS } from "../acquisitions";
---

<Base
  title="Collection"
  description="The catalog of the Santa Monica Athenaeum: mathematics and philosophy, primary texts, open shelves."
>
  <h1>The collection</h1>
  <p>
    Mathematics and philosophy, primary texts first. Open shelves;
    everything lends.
  </p>
  <!--
    TODO: TinyCat embed goes here. Either:
      - link out:  <a href="https://www.librarycat.org/lib/YOUR_LIBRARY">Browse the catalog</a>
      - or embed:  TinyCat's iframe snippet from Admin → Widgets.
  -->
  <p><em>The online catalog is being prepared. Check back soon.</em></p>

  {
    ACQUISITIONS.length > 0 && (
      <section>
        <h2>Recent acquisitions</h2>
        <ul class="acquisitions">
          {ACQUISITIONS.map((a) => (
            <li>
              <em>{a.title}</em>, {a.author}
              {a.note && <span class="note"> — {a.note}</span>}
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  h1 {
    text-align: left;
  }

  .acquisitions {
    list-style: none;
    padding-left: 0;
  }

  .acquisitions li {
    margin-bottom: 0.5rem;
  }

  .note {
    font-size: 0.9rem;
  }
</style>
